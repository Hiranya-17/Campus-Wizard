# Copy to .env.local and fill in. Every setting is optional: without them the app still runs
# (Rhett uses keyword rules, accounts are stored in data/.local-db.json).

# Google Gemini key for Rhett's conversation, receipt reading and syllabus/email extraction
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Random string that signs login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Account storage on Vercel: connect a Redis database (Storage tab) and Vercel fills one of these in
REDIS_URL=
# or Upstash REST:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: raises MBTA API rate limits (https://api-v3.mbta.com)
MBTA_API_KEY=

# Google sign-in, Gmail import and Google Calendar export (all optional; the buttons stay hidden without them)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web). Consent screen in Testing mode:
# add every tester's Gmail as a test user (gmail.readonly is a restricted scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# must match the redirect URI registered on the OAuth client exactly
GOOGLE_REDIRECT_URI=https://campuswizard.vercel.app/api/google/callback
